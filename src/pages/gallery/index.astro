---
/**
 * 光影画廊
 *
 * 照片不用在这个文件里登记 —— 构建时会自动扫描 public/photos/ 目录：
 *
 *   public/photos/武汉江边/01.jpg   →  相册「武汉江边」，封面取第一张
 *   public/photos/武汉江边/02.jpg
 *   public/photos/某个相册/xxx.png
 *
 * 想给相册加说明和日期，去 src/config.ts 的 ALBUMS 里按目录名写一条即可，不写也能用。
 * 目录是空的（现在就是），页面会显示一句引导。
 */
import fs from 'node:fs';
import path from 'node:path';
import Layout from '@layouts/Layout.astro';
import NavBar from '@components/NavBar.astro';
import Footer from '@components/Footer.astro';
import { ALBUMS } from '@/config';
import { withBase } from '@/utils/url';

const PHOTO_ROOT = path.join(process.cwd(), 'public', 'photos');
const IMG_RE = /\.(jpe?g|png|webp|gif|avif|svg)$/i;

interface Album {
  name: string;
  photos: string[];
  cover: string;
  desc: string;
  date: string;
}

const albums: Album[] = [];

if (fs.existsSync(PHOTO_ROOT)) {
  for (const entry of fs.readdirSync(PHOTO_ROOT, { withFileTypes: true })) {
    if (!entry.isDirectory() || entry.name.startsWith('.')) continue;
    const dir = path.join(PHOTO_ROOT, entry.name);
    const files = fs
      .readdirSync(dir)
      .filter((f) => IMG_RE.test(f))
      .sort((a, b) => a.localeCompare(b, 'zh'));
    if (files.length === 0) continue;

    const url = (f: string) =>
      withBase(`/photos/${encodeURIComponent(entry.name)}/${encodeURIComponent(f)}`);
    const meta = ALBUMS[entry.name] ?? {};

    albums.push({
      name: entry.name,
      photos: files.map(url),
      cover: url(files[0]),
      desc: meta.desc ?? '',
      date: meta.date ?? '',
    });
  }
  // 有日期的排前面
  albums.sort((a, b) => (b.date || '').localeCompare(a.date || ''));
}

const totalPhotos = albums.reduce((a, x) => a + x.photos.length, 0);
---

<Layout title="光影画廊" description="定格时间，封存虚拟与现实的每一次心跳。">
  <div class="game-scene">
    <div class="scroll-container">
      <div class="web-wrapper">
        <NavBar />

        <div class="gallery-header">
          <h1 class="gallery-title">光影画廊</h1>
          <p class="gallery-subtitle">定格时间，封存虚拟与现实的每一次心跳</p>
          {totalPhotos > 0 && <span class="gallery-count">{totalPhotos} 张照片</span>}
        </div>

        {
          albums.length > 0 ? (
            <div class="album-grid">
              {albums.map((album) => (
                <div class="album-card">
                  <div class="album-stack">
                    <img src={album.cover} alt={album.name} loading="lazy" />
                    <span class="album-thumb-count">{album.photos.length} 张</span>
                  </div>
                  <div class="album-info">
                    <div class="album-name">{album.name}</div>
                    {album.desc && <div class="album-desc">{album.desc}</div>}
                    {album.date && <div class="album-date">{album.date}</div>}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-hint">
              <strong>画廊还是空的</strong>
              把照片丢进 <code>public/photos/相册名/</code> 目录，重新构建就会自动出现相册。<br />
              相册的封面取目录里第一张图；想加说明和日期，在 <code>src/config.ts</code> 的{' '}
              <code>ALBUMS</code> 里按目录名写一条。
            </div>
          )
        }

        <Footer />
      </div>
    </div>
  </div>
</Layout>
