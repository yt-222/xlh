---
/**
 * 光影画廊
 *
 * 照片不在这个文件里登记，也不用手动放目录 —— 由工作区根目录的
 * `build-images.mjs` 从本机壁纸文件夹统一处理：
 *
 *   原图  →  400px 缩略图(webp) + 1600px avif + 1600px webp
 *         →  public/media/<相册>/
 *         →  src/data/photos.json（本页据此渲染）
 *
 * 相册按拍摄年月自动归组。分组逻辑、压缩参数都在那个脚本里，
 * 换照片只需重跑一次脚本，本页不用改。
 *
 * 性能处理（按用户要求）：
 *   - 全部图片 loading="lazy"，只有首屏前几张是 eager
 *   - 首图给 fetchpriority="high"，让浏览器优先拉它
 *   - 每张图写死 width/height + CSS aspect-ratio，图片没到也不跳动（防 CLS）
 *   - 用 <picture> 提供 avif，不支持时回落 webp
 */
import fs from 'node:fs';
import path from 'node:path';
import Layout from '@layouts/Layout.astro';
import NavBar from '@components/NavBar.astro';
import Footer from '@components/Footer.astro';
import Lightbox from '@components/Lightbox.astro';
import { withBase } from '@/utils/url';

interface Photo {
  slug: string;
  w: number;
  h: number;
  portrait: boolean;
  thumb: string;
  avif: string;
  webp: string;
  alt: string;
}
interface Album {
  key: string;
  title: string;
  count: number;
  photos: Photo[];
}

const MANIFEST = path.join(process.cwd(), 'src', 'data', 'photos.json');

let albums: Album[] = [];
try {
  albums = JSON.parse(fs.readFileSync(MANIFEST, 'utf8')) as Album[];
} catch {
  albums = [];
}

/* 先摊平拿全局序号，再回填 —— 灯箱的上一张/下一张要能跨相册连续切换 */
const allPhotos = albums.flatMap((a) => a.photos);
let cursor = 0;
const albumsIndexed = albums.map((a) => {
  const photos = a.photos.map((p, i) => ({ ...p, lbIndex: cursor + i }));
  cursor += a.photos.length;
  return { ...a, photos };
});

const totalPhotos = allPhotos.length;
const totalAlbums = albums.length;
/* 首屏大约能看到 6 张，这几张不懒加载 */
const EAGER_COUNT = 6;

const years = [...new Set(albumsIndexed.map((a) => a.key.split('-')[0]))].sort((a, b) => b.localeCompare(a));
---

<Layout
  title="光影画廊"
  description={`把镜头里的时间收进小屋 —— 共 ${totalAlbums} 个相册、${totalPhotos} 张照片。`}
>
  <div class="game-scene">
    <div class="scroll-container">
      <div class="web-wrapper">
        <NavBar />

        <div class="gallery-header">
          <h1 class="gallery-title">光影画廊</h1>
          <p class="gallery-subtitle">把镜头里的时间，一张张收进这间小屋</p>
          {
            totalPhotos > 0 && (
              <span class="gallery-count">
                {totalAlbums} 个相册 · {totalPhotos} 张照片
              </span>
            )
          }
        </div>

        {
          totalPhotos > 0 ? (
            <>
              {/* 相册快捷导航：滚到某个年月 */}
              <nav class="album-nav" aria-label="相册导航">
                {albumsIndexed.map((a) => (
                  <a href={`#album-${a.key}`} class="album-pill">
                    {a.title}
                    <span class="album-pill__count">{a.count}</span>
                  </a>
                ))}
              </nav>

              {albumsIndexed.map((album) => (
                <section class="album-section" id={`album-${album.key}`}>
                  <h2 class="album-section__title">
                    {album.title}
                    <span class="album-section__count">{album.count} 张</span>
                  </h2>

                  {/* 瀑布流：保持每张照片的原始比例，不做统一裁切 */}
                  <div class="photo-masonry">
                    {album.photos.map((p) => {
                      const eager = p.lbIndex < EAGER_COUNT;
                      return (
                        <button
                          class="photo-card"
                          type="button"
                          data-lb-index={p.lbIndex}
                          aria-label={`放大查看：${p.alt}`}
                        >
                          <span
                            class="img-frame"
                            style={`--img-ratio:${p.w}/${p.h}`}
                          >
                            <picture>
                              <source srcset={withBase(p.avif)} type="image/avif" />
                              <img
                                src={withBase(p.thumb)}
                                width={p.w}
                                height={p.h}
                                alt={p.alt}
                                loading={eager ? 'eager' : 'lazy'}
                                decoding={eager ? 'sync' : 'async'}
                                fetchpriority={p.lbIndex === 0 ? 'high' : undefined}
                              />
                            </picture>
                          </span>
                          <span class="photo-card__meta">{p.alt}</span>
                          <span class="photo-card__zoom" aria-hidden="true">
                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <circle cx="11" cy="11" r="7" />
                              <path d="m20 20-3.5-3.5M11 8v6M8 11h6" />
                            </svg>
                          </span>
                        </button>
                      );
                    })}
                  </div>
                </section>
              ))}

              <Lightbox photos={allPhotos} />

              <p class="gallery-footnote">
                共 {totalPhotos} 张 · 图片已压缩为 WebP / AVIF，点击任意一张可放大查看（支持 ← → 切换、Esc 关闭）
              </p>
            </>
          ) : (
            <div class="empty-hint">
              <strong>画廊还没有照片</strong>
              在工作区根目录运行 <code>node build-images.mjs</code>，它会读取本机壁纸目录
              （<code>D:\One Drive\OneDrive\图片\本机照片\图片壁纸</code>），
              压缩成 WebP / AVIF 并生成相册清单 <code>src/data/photos.json</code>。
            </div>
          )
        }

        <Footer />
      </div>
    </div>
  </div>
</Layout>
