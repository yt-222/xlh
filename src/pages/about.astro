---
import Layout from '@layouts/Layout.astro';
import NavBar from '@components/NavBar.astro';
import Footer from '@components/Footer.astro';
import { SITE, SKILLS, NOW_ITEMS, SOCIAL_LINKS } from '@/config';

/** 关于我：想改自我介绍就改这里 */
const BIO = [
  '你好，我是 ' + SITE.author + '，一个热爱折腾的开发者。',
  '这里记录我的学习笔记、项目复盘和日常碎碎念。',
  '相信每一行代码都可以是有温度的，欢迎你来到这里。',
];

const ICONS: Record<string, string> = {
  github:
    'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4|M9 18c-4.51 2-5-2-7-2',
  bilibili:
    'M4 8h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z|M8 4l2 4M16 4l-2 4|M9 13h.01M15 13h.01',
  mail: 'M2 6h20v12H2z|M2 6l10 7 10-7',
};
---

<Layout title="关于" description={`关于 ${SITE.author}`}>
  <div class="game-scene">
    <div class="scroll-container">
      <div class="web-wrapper">
        <NavBar />

        <div class="page-header">
          <h1 class="page-title">关于</h1>
          <p class="page-subtitle">Hello, World!</p>
        </div>

        <div class="about-grid">
          <!-- 左侧名片 -->
          <aside class="about-side">
            <div class="about-card animate-in">
              <div class="about-avatar-ring">
                <div class="about-avatar-inner">{SITE.avatarText}</div>
              </div>
              <div class="about-name">{SITE.author}</div>
              <div class="about-role">{SITE.role}</div>
              <div class="about-divider"></div>
              <div class="about-contact">
                {
                  SOCIAL_LINKS.map((s) => (
                    <a href={s.href} target="_blank" rel="noopener" title={s.name}>
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={(ICONS[s.icon] || '')
                          .split('|')
                          .map((d) => `<path d="${d}" />`)
                          .join('')}
                      />
                    </a>
                  ))
                }
              </div>
            </div>
          </aside>

          <!-- 右侧内容 -->
          <div class="about-main">
            <div class="about-card">
              <h3 class="about-section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                  ><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                  ></path></svg>
                关于我
              </h3>
              <div class="about-text">
                {BIO.map((line) => <p style="margin: 0 0 0.7em;">{line}</p>)}
              </div>
            </div>

            <div class="about-card">
              <h3 class="about-section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                  ><path d="m8 3 4 8 5-5 5 15H2L8 3z"></path></svg>
                技能
              </h3>
              <div class="skills-grid">
                {
                  SKILLS.map((s) => (
                    <div class="skill-item">
                      <div class="skill-icon">{s.icon}</div>
                      <div class="skill-name">{s.name}</div>
                      <div class="skill-level">{s.level}</div>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="about-card">
              <h3 class="about-section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                  ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
                  ></polyline></svg>
                此刻正在...
              </h3>
              <div class="now-items">
                {
                  NOW_ITEMS.map((item) => (
                    <div class="now-item">
                      <span class:list={['now-dot', item.dot]} />
                      {item.text}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <Footer />
      </div>
    </div>
  </div>
</Layout>
