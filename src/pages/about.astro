---
/**
 * 关于页 —— 不只是「一张名片」，而是完整回答三个问题：
 *   我是谁 / 这间小屋是什么 / 现在在忙什么
 * 文案集中在前面的 ABOUT / SITE_ABOUT 常量里，改起来不用动结构。
 */
import Layout from '@layouts/Layout.astro';
import NavBar from '@components/NavBar.astro';
import Footer from '@components/Footer.astro';
import { SITE, SKILLS, NOW_ITEMS, ACTIVE_SOCIAL_LINKS } from '@/config';

/** 自我介绍（按真实背景写的初稿，随时改） */
const ABOUT = [
  '你好，我是 lzz，坐标武汉江夏，一个喜欢把想法亲手做出来的开发者。',
  '白天写代码，晚上折腾各种小项目：从前端界面到嵌入式开发板，从给常用软件换皮肤，到给摄像头搭一条无线视频流。技术对我来说不只是饭碗，更像一套积木 —— 享受的是拼出东西那一刻。',
  '这间小屋是我的「引力场」：写过的笔记、做过的项目、拍下的照片、闪过的念头，都会被吸进来，按时间沉淀在这里。',
];

/** 关于这个小站 */
const SITE_ABOUT = [
  { k: '名字由来', v: '好东西会互相吸引 —— 代码、影像、文字在这间屋子里聚在一起，所以叫「引力小屋」。' },
  { k: '技术栈', v: 'Astro 静态生成 + 手写 CSS 设计令牌，无重型框架，首屏极快；图片全部压缩为 WebP / AVIF。' },
  { k: '托管', v: 'Cloudflare Pages 全球边缘节点，源码在 GitHub 上同步维护。' },
  { k: '小彩蛋', v: '点点页面空白处、按一下 / 键、看看左下角 —— 这屋子比看上去好玩。' },
];

const ICONS: Record<string, string> = {
  github:
    'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4|M9 18c-4.51 2-5-2-7-2',
  bilibili:
    'M4 8h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z|M8 4l2 4M16 4l-2 4|M9 13h.01M15 13h.01',
  douyin:
    'M9 18V5l12-2v13|M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0z|M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
  mail: 'M2 6h20v12H2z|M2 6l10 7 10-7',
};
---

<Layout title="关于" description={`关于 ${SITE.author} 与 ${SITE.title}`}>
  <div class="game-scene">
    <div class="scroll-container">
      <div class="web-wrapper">
        <NavBar />

        <div class="page-header">
          <h1 class="page-title">关于</h1>
          <p class="page-subtitle">认识一下屋主，也认识一下这间屋子</p>
        </div>

        <div class="about-grid">
          <!-- 左侧名片 -->
          <aside class="about-side">
            <div class="about-card animate-in" data-spotlight>
              <div class="about-avatar-ring">
                <div class="about-avatar-inner">{SITE.avatarText}</div>
              </div>
              <div class="about-name">{SITE.author}</div>
              <div class="about-role">{SITE.role}</div>
              <div class="about-loc">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {SITE.cityLabel}
              </div>
              <div class="about-divider"></div>
              <div class="about-contact">
                {
                  ACTIVE_SOCIAL_LINKS.map((s) => (
                    <a href={s.href} target="_blank" rel="noopener" title={s.name}>
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={(ICONS[s.icon] || '')
                          .split('|')
                          .map((d) => `<path d="${d}" />`)
                          .join('')}
                      />
                    </a>
                  ))
                }
              </div>
            </div>
          </aside>

          <!-- 右侧内容 -->
          <div class="about-main">
            <div class="about-card" data-animate>
              <h3 class="about-section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                  ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"
                  ></circle></svg>
                我是谁
              </h3>
              <div class="about-text">
                {ABOUT.map((line) => <p style="margin: 0 0 0.7em;">{line}</p>)}
              </div>
            </div>

            <div class="about-card" data-animate>
              <h3 class="about-section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                  ><path d="M3 12c0-2.4 4-4.4 9-4.4s9 2 9 4.4-4 4.4-9 4.4S3 14.4 3 12z"></path><circle
                    cx="12"
                    cy="12"
                    r="1.6"></circle></svg>
                这间小屋
              </h3>
              <div class="about-facts">
                {
                  SITE_ABOUT.map((f) => (
                    <div class="about-fact">
                      <span class="about-fact__k">{f.k}</span>
                      <span class="about-fact__v">{f.v}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="about-card" data-animate>
              <h3 class="about-section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                  ><path d="m8 3 4 8 5-5 5 15H2L8 3z"></path></svg>
                趁手的工具
              </h3>
              <div class="skills-grid">
                {
                  SKILLS.map((s) => (
                    <div class="skill-item">
                      <div class="skill-icon">{s.icon}</div>
                      <div class="skill-name">{s.name}</div>
                      <div class="skill-level">{s.level}</div>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="about-card" data-animate>
              <h3 class="about-section-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                  ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
                  ></polyline></svg>
                此刻正在...
              </h3>
              <div class="now-items">
                {
                  NOW_ITEMS.map((item) => (
                    <div class="now-item">
                      <span class:list={['now-dot', item.dot]} />
                      {item.text}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <Footer />
      </div>
    </div>
  </div>
</Layout>
