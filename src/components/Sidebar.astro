---
/**
 * 侧边栏（支持左右分区）
 *
 * 三栏布局下按 side 渲染成两列，参考 Firefly 的双侧边栏思路。
 * 这么分不是为了左右对称，而是让两种性质的卡片各归其位：
 *
 *   side="left"   身份与导览 —— 名片、公告、分类、标签、联系方式
 *                 「你是谁、我能去哪」：进来扫一眼就够，不需要一直盯着
 *   side="right"  工具与状态 —— 天气、写作轨迹、技能、此刻正在
 *                 「现在怎样、你会什么」：滚动中随时会想瞄一眼
 *
 * 每块都挂了 data-spotlight —— 鼠标划过时有一团柔光跟着走。
 */
import { SITE, SKILLS, NOW_ITEMS, ACTIVE_SOCIAL_LINKS } from '@/config';
import { withBase } from '@/utils/url';
import WeatherCard from '@components/WeatherCard.astro';
import CalendarHeatmap from '@components/CalendarHeatmap.astro';
import AnnounceBox from '@components/AnnounceBox.astro';

interface PostLite {
  id: string;
  title: string;
  date: Date;
}

interface Props {
  /** 渲染成哪一侧；不传按右栏处理 */
  side?: 'left' | 'right';
  postCount: number;
  categories: { name: string; count: number }[];
  tags: { name: string; count: number }[];
  posts: PostLite[];
}

const { side = 'right', postCount, categories, tags, posts } = Astro.props;

const ICONS: Record<string, string> = {
  github:
    'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4|M9 18c-4.51 2-5-2-7-2',
  bilibili:
    'M4 8h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z|M8 4l2 4M16 4l-2 4|M9 13h.01M15 13h.01',
  douyin:
    'M9 18V5l12-2v13|M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0z|M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
  mail: 'M2 6h20v12H2z|M2 6l10 7 10-7',
};
---

<div class:list={['sidebar', `sidebar-${side}`]}>
  {
    side === 'left' ? (
      <>
        {/* 身份名片 */}
        <div class="sidebar-block profile-card" data-spotlight data-animate>
          <div class="profile-avatar">
            <span class="profile-avatar-ring" aria-hidden="true" />
            <span class="profile-avatar-text">{SITE.avatarText}</span>
          </div>
          <div class="profile-name">{SITE.author}</div>
          <div class="profile-role">{SITE.role}</div>

          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-number" data-count={postCount}>
                {postCount}
              </div>
              <div class="stat-label">POSTS</div>
            </div>
            <div class="stat-item">
              <div class="stat-number" data-count={tags.length}>
                {tags.length}
              </div>
              <div class="stat-label">TAGS</div>
            </div>
          </div>
        </div>

        {/* 公告（config 里没写就自动隐藏） */}
        <AnnounceBox />

        {/* 分类 */}
        {categories.length > 0 && (
          <div class="sidebar-block" data-spotlight>
            <h3 class="sidebar-title">分类</h3>
            <div class="cat-list">
              {categories.map((c) => (
                <a href={withBase(`/tags/${encodeURIComponent(c.name)}/`)} class="cat-item">
                  <span>{c.name}</span>
                  <span class="count">{c.count}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* 标签云 */}
        {tags.length > 0 && (
          <div class="sidebar-block" data-spotlight>
            <h3 class="sidebar-title">标签</h3>
            <div class="tag-cloud">
              {tags.slice(0, 24).map((t) => (
                <a href={withBase(`/tags/${encodeURIComponent(t.name)}/`)} class="chip">
                  #{t.name}
                </a>
              ))}
            </div>
          </div>
        )}

        {/* 联系方式（href 留空的项自动隐藏） */}
        {ACTIVE_SOCIAL_LINKS.length > 0 && (
          <div class="sidebar-block" data-spotlight>
            <h3 class="sidebar-title">找到我</h3>
            <div class="about-contact">
              {ACTIVE_SOCIAL_LINKS.map((s) => (
                <a href={s.href} target="_blank" rel="noopener" title={s.name} aria-label={s.name}>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={(ICONS[s.icon] || '')
                      .split('|')
                      .map((d) => `<path d="${d}" />`)
                      .join('')}
                  />
                </a>
              ))}
            </div>
          </div>
        )}
      </>
    ) : (
      <>
        {/* 天气卡（江夏实时） */}
        <WeatherCard />

        {/* 写作轨迹（日历热力图） */}
        <CalendarHeatmap posts={posts} />

        {/* 技能 */}
        <div class="sidebar-block" data-spotlight>
          <h3 class="sidebar-title">技能</h3>
          <div class="skills-grid">
            {SKILLS.map((s) => (
              <div class="skill-item">
                <div class="skill-icon">{s.icon}</div>
                <div class="skill-name">{s.name}</div>
                <div class="skill-level">{s.level}</div>
              </div>
            ))}
          </div>
        </div>

        {/* 此刻正在 */}
        <div class="sidebar-block" data-spotlight>
          <h3 class="sidebar-title">此刻正在...</h3>
          <div class="now-items">
            {NOW_ITEMS.map((item) => (
              <div class="now-item">
                <span class:list={['now-dot', item.dot]} />
                {item.text}
              </div>
            ))}
          </div>
        </div>
      </>
    )
  }
</div>
