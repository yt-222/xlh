---
/**
 * Live2D 看板娘 —— 雪初音（snow_miku）
 *
 * 参考站（momonyako.ccwu.cc）用的是同一套东西。抄它之前先看了它的实现，有三点值得说：
 *
 * 1) **自托管，不用官方模型 CDN**。参考站自己也把库和模型放在站内。
 *    原本想用「官方」的 model.oml2d.com，实测已经被赌博站劫持 ——
 *    请求 /HK416-1-normal/model.json 返回的是「51吃瓜网」的 HTML 页面。
 *    这类资源一旦被别人接管，轻则人物不显示、重则加载来一堆奇怪东西，所以必须自托管。
 *
 * 2) **挂进常驻层**。本组件被放在 Layout 的 `transition:persist` 容器里，
 *    交上去的 DOM 连同 canvas 一起在站内跳转时原样保留 ——
 *    换页面人物不会闪一下重来，也不会把 429KB 的贴图重新下一遍。
 *    （`parentElement` 必须显式指向这块容器，否则库默认挂到 body，
 *     而 body 里的东西是会被 ClientRouter 换掉的。）
 *
 * 3) **延迟加载**。库 979KB（传输约 267KB）、贴图 429KB，加起来不该跟首屏抢带宽。
 *    所以等 window.load 之后再在空闲时段拉，且只在「明确」的省流/慢网/小屏信号下跳过。
 *    ⚠️ 别再用 effectiveType 的 3g 档当门槛 —— 理由见脚本里那段长注释，
 *    简单说就是它「还没测出网速」时默认就报 3g，会把所有首次访问的人误杀。
 *
 * 4) **「加载成功」不等于「看得见」**。这个组件栽过两次，都是同一个盲区：
 *    · 库把休息状态持久化在 localStorage.OML2D_STATUS，而唤醒入口只有状态条 ——
 *      我们把状态条关了，于是残留的 sleep 会让访客永久看不到人（脚本里已清掉该键）；
 *    · 库的滑入靠一条 CSS 动画把舞台从 translateY(130%)（视口外）拉回来，
 *      动画没落地时静态位置就是「藏在视口下面」，而控制台毫无提示。
 *    所以验收一律量 getBoundingClientRect()，不许用「截元素看有没有颜色」——
 *    元素在视口外时截元素照样能截到画好的内容，会得出假的「正常」。
 *
 * 配置在 src/config.ts 的 LIVE2D 里。
 */
import { LIVE2D } from '@/config';
import { withBase } from '@/utils/url';

const cfg = LIVE2D;
const libUrl = withBase('/' + cfg.libPath.replace(/^\//, ''));
const modelUrl = withBase('/' + cfg.modelPath.replace(/^\//, ''));
const rewardUrl = withBase('/reward/');
const aboutUrl = withBase('/about/');

/** 传给库的配置（放到 data 属性里，避免在 is:inline 脚本里写对象字面量） */
const runtime = {
  scale: cfg.scale,
  position: [...cfg.position],
  stage: cfg.stage,
  stageBottom: cfg.stageBottom,
  transitionTime: cfg.transitionTime,
  mobileDisplay: cfg.mobileDisplay,
  hideStatusBar: cfg.hideStatusBar,
  welcome: cfg.welcome,
  idleLines: [...cfg.idleLines],
  primaryColor: '#38bdf8',
  libUrl,
  modelUrl,
  rewardUrl,
  aboutUrl,
};
---

{
  cfg.enable && (
    <div
      class="live2d-host"
      id="cabin-live2d-host"
      data-live2d-host
      data-runtime={JSON.stringify(runtime)}
      aria-hidden="true"
    />
  )
}

{
  cfg.enable && (
    <script is:inline data-astro-rerun>
      /* 这段在常驻层里，本来跳页就不会重跑（元素被保留）；
         但照样带 data-astro-rerun 兜底：万一有人把这个组件挪到常驻层外面，
         也不至于出现「第一次能跑、跳页回来就没了」这种最难查的毛病。
         window.__cabinLive2d 守卫保证无论重跑多少次都只初始化一次。 */
      (function () {
        if (window.__cabinLive2d) return;
        var host = document.querySelector('[data-live2d-host]');
        if (!host) return;
        window.__cabinLive2d = true;

        var cfg;
        try {
          cfg = JSON.parse(host.dataset.runtime || '{}');
        } catch (e) {
          return;
        }

        var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection || {};

        /* ---------- 该不该加载 ----------
           这里踩过一个很深的坑，写下来免得以后又改回去。

           原来在**解析阶段**就读 navigator.connection.effectiveType，
           只要它报 2g 或 3g 就不加载。结果是：**第一次打开首页永远看不到人，
           刷新一下就出来了**。查了半天，用 CDP 在页面脚本之前插桩，
           把「守卫被读的那一刻」的值快照下来才看明白：

             SNAPSHOT@flag eff=3g saveData=false rtt=400 downlink=0.4

           effectiveType 不是「测出来的」，是 Chrome 的网络质量估算器
           **基于已观测到的流量估算**出来的。标签页刚打开、还没传过任何
           字节时它没有数据，于是给一份保守默认值 —— 恰好就是
           rtt=400 / downlink=0.4 / effectiveType 报成 3g。
           真跑起来几秒后才修正成 4g。

           所以 3g 这一个档位完全没有参考价值：它既可能是真 3g，
           也可能是「还不知道」。而 2g / slow-2g 只会在真的观测到很慢时
           才出现（未知状态的默认值是 3g），拿来当门槛是安全的。

           结论：只在**明确**信号下放弃加载 ——
             · saveData：用户亲手开了省流开关
             · prefers-reduced-data：系统级的省流量偏好
             · 2g / slow-2g：确实慢到不该下
           不拿 3g 当门槛。库 + 模型合计约 700KB，而且本来就推迟到
           load 之后的空闲时段才拉，不会跟首屏抢带宽。 */

        var CONN = conn;

        /** 返回跳过原因；空字符串表示可以加载 */
        function skipReason() {
          try {
            if (window.matchMedia('(prefers-reduced-data: reduce)').matches) return '系统省流量偏好';
          } catch (e) {
            /* 老浏览器没这个媒体查询，忽略 */
          }
          if (CONN.saveData) return '用户开了省流模式';
          /* 注意只拦 2g / slow-2g，理由见上面那段 */
          if (/^(slow-)?2g$/.test(CONN.effectiveType || '')) return '网络确实很慢';
          if (!cfg.mobileDisplay && window.matchMedia('(max-width: 768px)').matches) return '小屏没地方放';
          return '';
        }

        var booted = false;

        /* ---------- 落地校验（兜底） ----------
           这是查「加载全成功、但页面上看不见人」时挖出来的第二个坑。

           库的「滑入」纯靠一条 CSS 动画：
             stage.setStyle({ animationName: 'oml2d-stage-slide-in', animationFillMode: 'forwards' })
           而舞台的**静态** transform 一直留着 translateY(130%)（= 视口正下方，看不见）。
           换句话说，静态样式本来就把人藏在视口外，全靠那条动画在播完后把它拉回来。

           于是只要动画没播完/没生效（样式竞态、动画被外部禁用、库状态被判成 sleep、
           模型加载在中途断掉），结果就是：**控制台一声不响，资源全 200，人却停在视口外**。
           这正是最难查的那类「看起来全都对，就是看不见」。

           所以这里不信任动画，自己验一次「人是不是真在视口里」：
           等库把 status 置为 true（= 它认为滑入已完成）之后量一次 rect，
           还在视口外就判定动画没落地，直接把静态位改写成 transform:none。

           ⚠️ 反过来也要注意：验证必须量 `getBoundingClientRect()` 而不是
           「截元素看有没有颜色」—— 元素被摆在视口外时，截元素照样能截到画好的内容，
           那会得出「显示正常」的假结论。

           ⚠️ 而且这段守望**必须先确认舞台已被库接管**再判断位置，否则会被
           「还没接管时的初始壳」骗过去（它恰好也满足『在视口内』）——
           细节写在下面 stageReady() 上，这是第一版兜底失效的真因。 */
        /** 兜底自己的诊断记录，方便测试区分「没触发」和「提前下班」 */
        window.__l2dLanded = { polls: 0, forced: 0, stop: '' };

        /**
         * 舞台有没有被库真正接管。
         *
         * ⚠️ 这个判断是兜底第一版栽过的地方，别删。
         * 库创建 <div id="oml2d-stage"> 之后，有一段「还没被接管」的窗口期：
         * 它是 position:static、占满整宽（1422px）、高 24px、贴在文档顶部。
         * 而兜底原本只问「宽高都 >0 且有一部分落在视口里吗」—— 这个初始壳
         * **恰好全部满足**，于是兜底以为人已经落位，直接清掉定时器下班。
         * 等库真正把舞台摆成 fixed + translateY(130%)（视口下方，看不见）时，
         * 已经没有人在看着它了。症状和「兜底没写」完全一样，很能骗人。
         *
         * 所以必须先确认形态：position 落到 fixed/absolute，且尺寸像舞台。
         */
        function stageReady(st) {
          if (!st) return false;
          var g = window.getComputedStyle(st);
          if (g.position !== 'fixed' && g.position !== 'absolute') return false;
          var r = st.getBoundingClientRect();
          return r.width >= 120 && r.height >= 120;
        }

        function ensureLanded(api) {
          var log = window.__l2dLanded;
          var tries = 0;
          var MAX = 44; /* 700ms × 44 ≈ 30s：够下完 979KB 库 + 429KB 贴图再滑入 */
          var HARD = MAX + 8; /* 摆回之后再给它一点观察时间 */
          var timer = setInterval(function () {
            tries++;
            log.polls = tries;
            var st = document.getElementById('oml2d-stage');

            /* 还没被库接管（含上面说的那个初始壳）→ 什么都不判，继续等 */
            if (!api || !api.stage || !stageReady(st)) {
              if (tries > HARD) {
                log.stop = log.stop || 'give-up(never-ready)';
                clearInterval(timer);
              }
              return;
            }

            var r = st.getBoundingClientRect();
            var inView = r.top < window.innerHeight && r.bottom > 0;
            var claimed = api.stage.status === true; /* 库自己认为滑入已完成 */
            var settled = claimed || tries > MAX;    /* 已经过了「动画还在跑」的阶段 */

            if (inView && settled) {
              log.stop = 'in-view';
              clearInterval(timer);
              return;
            }

            if (!inView && settled) {
              /* ⚠️ 只在「库声称滑入已完成、人却还在视口外」时才补位 —— 这才是
                 「动画没落地」的确切特征。别放宽成「不在视口里就补」：
                 滑入动画刚起步那一刻，元素本来就在 translateY(130%) 的视口外，
                 放宽就会在动画开跑前先把她闪出来一下，再跳下去重新滑上来
                 （线上 B 场景真踩到过，兜底会误报一次）。 */
              try {
                api.stage.setStyle({ transform: 'none' });
                log.forced++;
                if (!log.stop) {
                  log.stop = 'force-transform';
                  console.info('[live2d] 滑入动画没落地，已把舞台直接摆回视口内');
                }
              } catch (e) {
                /* 兜底失败也不该把页面搞出报错 */
                log.stop = 'force-failed';
                clearInterval(timer);
                return;
              }
            }
            if (tries > HARD) {
              log.stop = log.stop || 'give-up(after-force)';
              clearInterval(timer);
            }
          }, 700);
        }

        function boot() {
          if (booted || !window.OML2D) return;
          booted = true;

          var stageW = (cfg.stage && cfg.stage.width) || 300;
          var stageH = (cfg.stage && cfg.stage.height) || 320;

          /* ---------- 清掉库持久化的「休息」状态 ----------
             库把休息状态**写进 localStorage**（键 OML2D_STATUS，值 'sleep'/'active'），
             并在 initialize() 里据此决定要不要滑入：

               const t = J0() || options.initialStatus;      // J0() 读 localStorage
               t === 'sleep'
                 ? (tips.clear(), statusBar.open(restMessage),
                    statusBar.setClickEvent(() => stage.slideIn()))   // ← 唯一的唤醒入口
                 : stage.slideIn();

             注意那个唤醒入口**只有状态条**。而我们为了让界面干净把状态条 disable 了
             （见 config.ts 的 hideStatusBar），于是那个元素根本不存在 ——
             一旦 localStorage 里留下 'sleep'，这个访客就**永久看不到人，也没有任何回程入口**。

             谁会写下 'sleep'：库自己的 stage.slideOut()（我们的「重新加载模型」菜单会走
             reloadModel → loadModel → slideOut）。正常情况紧接着就 slideIn 回来了，
             但只要中途跳页、加载失败或刷新，'sleep' 就留在那里变成单向陷阱。

             我们自己的「休息」用的是纯 CSS（html.l2d-asleep + 体外唤醒按钮），
             跟库这套状态机无关 —— 所以库这份持久化状态对我们只有害处。
             直接清掉：任何残留的 sleep 都不该让她消失。清掉后库回到默认 initialStatus='active'。 */
          try {
            localStorage.removeItem('OML2D_STATUS');
          } catch (e) {
            /* 隐私模式等取不到 localStorage，忽略即可 */
          }

          try {
            window.__cabinOml2d = window.OML2D.loadOml2d({
              /* 挂进常驻层，而不是默认的 document.body */
              parentElement: host,
              dockedPosition: 'left',
              mobileDisplay: false,
              primaryColor: cfg.primaryColor,
              transitionTime: cfg.transitionTime,
              stageStyle: {
                width: stageW,
                height: stageH,
                /* 抬高到音乐播放器上方：播放器固定在 left:20px / bottom:20px、占地 54×54，
                   不抬的话人物正好压在它身上 */
                bottom: (cfg.stageBottom || 76) + 'px',
                left: '0px',
                zIndex: 88,
              },
              models: [
                {
                  name: 'snow_miku',
                  path: cfg.modelUrl,
                  /* scale 与 position 是一对，必须同时调 —— 见 config.ts 里那段说明。
                     position 是模型原点相对舞台左上角的偏移，scale 一变它就得重算。 */
                  scale: cfg.scale || 0.0968,
                  position: cfg.position || [0, 0],
                  volume: 0,
                },
              ],
              /* 库里那条竖排状态条（加载中/加载成功）默认只从屏幕左缘露一小截，
                 看着像渲染残片，关掉。理由写在 config.ts 的 hideStatusBar 上。 */
              statusBar: { disable: cfg.hideStatusBar !== false },
              /* 气泡：优先说「今天这一句」，没有就随机说一句闲置台词 */
              tips: {
                messageLine: 4,
                style: { fontSize: '13px', lineHeight: '1.7' },
                welcomeTips: { duration: 8000, message: { morning: cfg.welcome } },
                idleTips: {
                  duration: 8000,
                  interval: 26000,
                  message: function () {
                    var q = window.__cabinDailyQuote;
                    if (q) return Promise.resolve('「' + q + '」');
                    var lines = cfg.idleLines || [];
                    if (!lines.length) return Promise.resolve('你好呀～');
                    return Promise.resolve(lines[Math.floor(Math.random() * lines.length)]);
                  },
                },
              },
              /* 菜单图标只能用库自带的 svg sprite：#icon-rest / icon-about / icon-like
                 / icon-skin / icon-setting / icon-switch / icon-loading，共 7 个。
                 它不走 iconify 之类的在线图标库，所以没有额外网络依赖。 */
              menus: {
                items: [
                  {
                    id: 'reward',
                    icon: 'icon-like',
                    title: '请我喝一杯',
                    onClick: function () {
                      window.location.href = cfg.rewardUrl;
                    },
                  },
                  {
                    id: 'about',
                    icon: 'icon-about',
                    title: '关于我',
                    onClick: function () {
                      window.location.href = cfg.aboutUrl;
                    },
                  },
                  {
                    id: 'rest',
                    icon: 'icon-rest',
                    title: '让她下去休息',
                    onClick: function (oml2d) {
                      /* 用「整块淡出 + 屏蔽点击」，而不是库的 stageSlideOut：
                         slideOut 会把菜单一起带走，人就再也叫不回来了。
                         这里菜单同样淡出，回程入口交给体外的 .l2d-wake 按钮。
                         注意只能改 opacity —— 在祖先上加 transform / filter 会让
                         里面 position:fixed 的舞台失去视口定位，人物会跑位。 */
                      document.documentElement.classList.add('l2d-asleep');
                      oml2d.tipsMessage('那我先去边上歇会儿～', 2500, 3);
                    },
                  },
                  {
                    id: 'reload',
                    icon: 'icon-switch',
                    title: '重新加载模型',
                    onClick: function (oml2d) {
                      document.documentElement.classList.remove('l2d-asleep');
                      oml2d.reloadModel();
                    },
                  },
                ],
              },
            });
          } catch (e) {
            console.warn('[live2d] 初始化失败，已跳过：', e && e.message);
          }

          /* 交给兜底去看一眼「人到底有没有落到视口里」 */
          ensureLanded(window.__cabinOml2d);
        }

        /* 自己写的「唤醒」按钮：休息状态下人物被 CSS 收走，需要一个常驻的回程入口 */
        function mountWakeButton() {
          if (document.getElementById('l2dWake')) return;
          var btn = document.createElement('button');
          btn.id = 'l2dWake';
          btn.className = 'l2d-wake';
          btn.type = 'button';
          btn.title = '把雪初音叫回来';
          btn.setAttribute('aria-label', '把雪初音叫回来');
          btn.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" ' +
            'stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/>' +
            '<circle cx="12" cy="12" r="4"/></svg>';
          btn.addEventListener('click', function () {
            document.documentElement.classList.remove('l2d-asleep');
            var api = window.__cabinOml2d;
            /* 我们的「休息」是 CSS 做的，但库那边也可能处在自己的「休息」状态
               （status === false，舞台被摆在 translateY(130%) 的视口外）。
               只切 class 是叫不回来的 —— 两套状态一起唤醒。 */
            if (api && api.stage && api.stage.status === false) {
              try {
                api.stage.slideIn();
              } catch (e) {
                /* 忽略：叫不回来也不该把页面搞出报错 */
              }
            }
            if (api) api.tipsMessage('我回来啦！', 3000, 3);
          });
          document.body.appendChild(btn);
        }

        function loadLib() {
          if (window.OML2D) {
            boot();
            return;
          }
          var s = document.createElement('script');
          s.src = cfg.libUrl;
          s.async = true;
          s.onload = boot;
          s.onerror = function () {
            /* 失败就静默跳过：看板娘是锦上添花，不能因为它把页面搞出报错 */
            console.warn('[live2d] 库加载失败，已跳过');
          };
          document.head.appendChild(s);
        }

        var retried = false;

        function start() {
          /* 判断放在这里（load 之后）而不是解析阶段：反正要下载也是这个点才下，
             在真正要花流量的时候再问「该不该花」，语义才对。 */
          var why = skipReason();
          if (why) {
            console.info('[live2d] 这次先不加载：' + why);
            /* 「网太慢」是一时的，等它变快了再补上 —— 别让用户永远看不到人。
               其余几种（省流开关、系统偏好、小屏）是用户的明确选择，不该自己反悔。 */
            if (why === '网络确实很慢' && !retried && CONN.addEventListener) {
              CONN.addEventListener('change', function onNet() {
                if (/^(slow-)?2g$/.test(CONN.effectiveType || '')) return;
                CONN.removeEventListener('change', onNet);
                retried = true;
                start();
              });
            }
            return;
          }
          mountWakeButton();
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadLib, { timeout: 3000 });
          } else {
            setTimeout(loadLib, 1200);
          }
        }

        if (document.readyState === 'complete') start();
        else window.addEventListener('load', start, { once: true });
      })();
    </script>
  )
}
