---
/**
 * 文章卡片
 *
 * 顶部一块封面区：
 *   文章 frontmatter 写了 cover 就用真图；
 *   没写就渲染一块「引力轨道」装饰板 —— 呼应全站的轨道母题，
 *   也让每张卡片都有头有尾，不必为了好看硬塞一张不相干的配图。
 *   装饰板的配色由 CSS 按 nth-child 轮换（见 global.css 第 8 节）。
 */
import type { PostItem } from '@/utils/posts';
import { withBase } from '@/utils/url';

interface Props {
  post: PostItem;
}

const { post } = Astro.props;
const cover = post.cover?.trim();
---

<a
  href={withBase(`/post/${post.id}/`)}
  class="post-card"
  data-animate
  data-spotlight
>
  {
    cover ? (
      <div class="post-card-cover">
        <img src={withBase(cover)} alt="" loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="post-card-cover deco" aria-hidden="true">
        <span class="deco-dot" />
      </div>
    )
  }

  <div class="post-card-head">
    <span class="post-date">{post.dateText}</span>
    {post.pinned && <span class="post-badge pinned">置顶</span>}
  </div>

  <h3 class="post-title">{post.title}</h3>
  {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}

  <div class="post-meta">
    <span class="chip cat">{post.category}</span>
    {post.tags.map((tag) => <span class="chip">#{tag}</span>)}
  </div>
</a>
