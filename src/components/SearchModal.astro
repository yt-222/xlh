---
/**
 * 本地搜索模态框（Butterfly local-search 风格）
 *
 * - 打开方式：导航栏放大镜按钮、快捷键 / 或 Ctrl+K
 * - 数据源 /search.json 第一次打开时才拉取，之后缓存在内存里
 * - 键盘：↑ ↓ 移动、Enter 跳转、Esc 关闭
 * - 命中文字用 <mark> 高亮
 */
import { withBase } from '@/utils/url';
---

<div class="search-modal" id="searchModal" hidden role="dialog" aria-modal="true" aria-label="站内搜索">
  <div class="search-modal__mask" data-search-close></div>
  <div class="search-modal__card" role="document">
    <div class="search-modal__bar">
      <svg
        class="search-modal__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        class="search-modal__input"
        id="searchInput"
        type="search"
        placeholder="搜索文章标题、标签、内容…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索关键词"
      />
      <kbd class="search-modal__kbd">Esc</kbd>
    </div>
    <div class="search-modal__results" id="searchResults" role="listbox">
      <div class="search-modal__placeholder">
        输入关键词开始搜索 · 共 <span id="searchTotal">0</span> 篇文章
      </div>
    </div>
    <div class="search-modal__foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>Enter</kbd> 打开</span>
      <span><kbd>/</kbd> 或 <kbd>Ctrl K</kbd> 唤起</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchUrl: withBase('/search.json'), base: withBase('/') }}>
  (function () {
    var modal = document.getElementById('searchModal');
    var input = document.getElementById('searchInput');
    var results = document.getElementById('searchResults');
    var total = document.getElementById('searchTotal');
    if (!modal || !input || !results) return;

    var index = null; // 懒加载的搜索索引
    var loading = false;
    var active = -1; // 键盘选中的结果序号
    var current = []; // 当前过滤出的结果

    function loadIndex() {
      if (index || loading) return;
      loading = true;
      fetch(searchUrl)
        .then(function (r) {
          return r.json();
        })
        .then(function (data) {
          index = data;
          if (total) total.textContent = String(data.length);
          if (input.value.trim()) render(input.value.trim());
        })
        .catch(function () {
          results.innerHTML = '<div class="search-modal__placeholder">搜索数据加载失败，请稍后再试</div>';
        });
    }

    function open() {
      modal.hidden = false;
      document.documentElement.classList.add('search-open');
      loadIndex();
      setTimeout(function () {
        input.focus();
      }, 30);
    }

    function close() {
      modal.hidden = true;
      document.documentElement.classList.remove('search-open');
      active = -1;
    }

    function esc(s) {
      return s.replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function mark(text, kw) {
      var t = esc(text);
      var k = esc(kw).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      return t.replace(new RegExp('(' + k + ')', 'gi'), '<mark>$1</mark>');
    }

    function render(kw) {
      if (!index) {
        results.innerHTML = '<div class="search-modal__placeholder">正在加载搜索数据…</div>';
        return;
      }
      var k = kw.toLowerCase();
      current = index.filter(function (p) {
        return (
          p.title.toLowerCase().indexOf(k) >= 0 ||
          (p.excerpt || '').toLowerCase().indexOf(k) >= 0 ||
          (p.category || '').toLowerCase().indexOf(k) >= 0 ||
          (p.tags || []).join(' ').toLowerCase().indexOf(k) >= 0
        );
      });
      active = current.length ? 0 : -1;

      if (!current.length) {
        results.innerHTML =
          '<div class="search-modal__placeholder">没有找到「' + esc(kw) + '」相关的内容</div>';
        return;
      }

      results.innerHTML = current
        .slice(0, 20)
        .map(function (p, i) {
          return (
            '<a class="search-hit' +
            (i === active ? ' is-active' : '') +
            '" role="option" href="' +
            base.replace(/\/$/, '') +
            p.url +
            '">' +
            '<span class="search-hit__title">' +
            mark(p.title, kw) +
            '</span>' +
            '<span class="search-hit__meta">' +
            esc(p.date || '') +
            (p.category ? ' · ' + mark(p.category, kw) : '') +
            '</span>' +
            (p.excerpt
              ? '<span class="search-hit__excerpt">' + mark(p.excerpt, kw) + '</span>'
              : '') +
            '</a>'
          );
        })
        .join('');
    }

    function move(dir) {
      if (!current.length) return;
      active = (active + dir + current.length) % current.length;
      var hits = results.querySelectorAll('.search-hit');
      hits.forEach(function (h, i) {
        h.classList.toggle('is-active', i === active);
      });
      var el = hits[active];
      if (el && el.scrollIntoView) el.scrollIntoView({ block: 'nearest' });
    }

    /* 输入防抖：150ms 够跟手又不闪 */
    var timer = 0;
    input.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(function () {
        var kw = input.value.trim();
        if (!kw) {
          current = [];
          active = -1;
          results.innerHTML =
            '<div class="search-modal__placeholder">输入关键词开始搜索 · 共 ' +
            (index ? index.length : 0) +
            ' 篇文章</div>';
          return;
        }
        render(kw);
      }, 150);
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Enter') {
        var hits = results.querySelectorAll('.search-hit');
        var el = hits[active >= 0 ? active : 0];
        if (el) {
          e.preventDefault();
          window.location.href = el.getAttribute('href');
        }
      }
    });

    /* 全局唤起：导航按钮 / 自定义事件 / 快捷键 */
    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('[data-search-open]')) open();
      if (e.target.closest && e.target.closest('[data-search-close]')) close();
    });
    window.addEventListener('open-search', open);

    document.addEventListener('keydown', function (e) {
      var tag = (e.target && e.target.tagName) || '';
      var typing = tag === 'INPUT' || tag === 'TEXTAREA' || (e.target && e.target.isContentEditable);
      if (e.key === 'Escape' && !modal.hidden) {
        close();
        return;
      }
      if (typing) return;
      if (e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault();
        if (modal.hidden) open();
        else close();
      }
    });
  })();
</script>
