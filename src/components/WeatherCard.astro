---
/**
 * 天气卡 —— 首页侧边栏顶部那块
 *
 * 数据源：Open-Meteo（https://open-meteo.com）
 *   - 完全免费、不需要注册、不需要 API key
 *   - 全程浏览器端请求，所以纯静态托管也能用；失败只显示提示，不影响其他内容
 *
 * 地点由 config.ts 的 SITE.latitude / SITE.longitude 决定（现在是武汉江夏区）。
 * 为什么不按城市名解析？实测 Open-Meteo 的城市库里没有「江夏区」，
 * 搜「江夏」会返回广东清远、安徽合肥、江西赣州那几个同名小地方 —— 会定到几百公里外。
 * SITE.cityLabel 只是卡片上显示的牌子，不参与定位。
 */
import { SITE } from '@/config';

const label = SITE.cityLabel.trim();
const lat = SITE.latitude.trim();
const lon = SITE.longitude.trim();
const city = SITE.city.trim();
const hasCoords = lat.length > 0 && lon.length > 0;
const enabled = hasCoords || city.length > 0;
---

<div
  class="widget-card weather-card"
  id="weather-card"
  data-spotlight
  data-label={label || '坐标定位'}
  data-lat={lat}
  data-lon={lon}
  data-city={city}
>
  <div class="uw-top-bar">
    <span class="uw-date" id="uw-date">--</span>
    <span class="uw-city-pill" id="uw-city">{label || '坐标定位'}</span>
    <span class="uw-clock" id="uw-clock">--:--:--</span>
  </div>

  {
    enabled ? (
      <div id="uw-body">
        <div class="uw-loading">
          <span class="uw-loading-dot" />
          <span class="uw-loading-dot" />
          <span class="uw-loading-dot" />
        </div>
      </div>
    ) : (
      <div class="uw-error">
        还没设置地点。打开 <code>src/config.ts</code>，填 <code>SITE.latitude</code> 与
        <code>SITE.longitude</code> 两个坐标即可（比填城市名稳，那个接口认不出区县名）。
      </div>
    )
  }
</div>

<script is:inline data-astro-rerun>
  /* ⚠️ 为什么必须是 `is:inline` + `data-astro-rerun`（这三点都是踩出来的）：
   *
   *   1) 不加 `is:inline` 的 <script> 会被 Astro 打包成外部 module（type="module" src=...）。
   *      而 module 按 URL 被浏览器缓存，ClientRouter 跳页回来**不会重新执行**。
   *   2) 内联脚本也要加 `data-astro-rerun`：ClientRouter 按「脚本内容文本」给内联脚本去重，
   *      内容相同的第二次出现会被刻意跳过，且不报错 —— 症状就是时钟停在 `--`、天气一直转圈。
   *   3) `is:inline` 的脚本**不经过编译**，所以这里只能写纯 JS：
   *      千万不要写 TS 类型标注（`: number`、`as string`、`Record<...>`），会直接在浏览器里报语法错。
   *
   * 数据从卡片自己的 data-* 属性读，不依赖 define:vars，也就不会有注入顺序问题。
   */
  (function () {
    var pad = function (n) {
      return String(n).padStart(2, '0');
    };
    var WEEK = ['日', '一', '二', '三', '四', '五', '六'];

    function tick() {
      var d = new Date();
      var dateEl = document.getElementById('uw-date');
      var clockEl = document.getElementById('uw-clock');
      if (dateEl) dateEl.textContent = d.getMonth() + 1 + '月' + d.getDate() + '日 周' + WEEK[d.getDay()];
      if (clockEl)
        clockEl.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
    }

    /* ---------- WMO 天气代码 → emoji + 中文（[白天图标, 文字, 夜间图标]） ---------- */
    var WMO = {
      0: ['☀️', '晴', '🌙'],
      1: ['🌤️', '少云', '🌙'],
      2: ['⛅', '多云', '☁️'],
      3: ['☁️', '阴', '☁️'],
      45: ['🌫️', '有雾', '🌫️'],
      48: ['🌫️', '雾凇', '🌫️'],
      51: ['🌦️', '毛毛雨', '🌦️'],
      53: ['🌦️', '小雨', '🌦️'],
      55: ['🌦️', '中雨', '🌧️'],
      56: ['🌧️', '冻雨', '🌧️'],
      57: ['🌧️', '冻雨', '🌧️'],
      61: ['🌦️', '小雨', '🌦️'],
      63: ['🌧️', '中雨', '🌧️'],
      65: ['🌧️', '大雨', '🌧️'],
      66: ['🌧️', '冻雨', '🌧️'],
      67: ['🌧️', '冻雨', '🌧️'],
      71: ['🌨️', '小雪', '🌨️'],
      73: ['🌨️', '中雪', '🌨️'],
      75: ['❄️', '大雪', '❄️'],
      77: ['🌨️', '雪粒', '🌨️'],
      80: ['🌦️', '阵雨', '🌦️'],
      81: ['🌧️', '阵雨', '🌧️'],
      82: ['⛈️', '强阵雨', '⛈️'],
      85: ['🌨️', '阵雪', '🌨️'],
      86: ['🌨️', '阵雪', '🌨️'],
      95: ['⛈️', '雷阵雨', '⛈️'],
      96: ['⛈️', '雷暴冰雹', '⛈️'],
      99: ['⛈️', '强雷暴', '⛈️'],
    };

    /** 只取 ISO 时间里的 HH:MM */
    function hhmm(iso) {
      return iso && iso.length >= 16 ? iso.slice(11, 16) : '--';
    }

    /** 城市名 → 经纬度（只在没配坐标时才走这条路） */
    async function geocode(name) {
      var candidates = [name, name + '市', name.replace(/市$/, '')].filter(function (v, i, arr) {
        return v.length > 0 && arr.indexOf(v) === i;
      });
      for (var i = 0; i < candidates.length; i++) {
        var url =
          'https://geocoding-api.open-meteo.com/v1/search?count=1&language=zh&format=json&name=' +
          encodeURIComponent(candidates[i]);
        var geo = await (await fetch(url)).json();
        var place = geo && geo.results && geo.results[0];
        if (place) return { lat: place.latitude, lon: place.longitude, label: place.name };
      }
      return null;
    }

    async function loadWeather(lat, lon, city) {
      var body = document.getElementById('uw-body');
      var pill = document.getElementById('uw-city');
      if (!body) return;

      try {
        var latitude, longitude;

        if (lat && lon) {
          latitude = Number(lat);
          longitude = Number(lon);
          if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
            throw new Error('config 里的经纬度不是有效数字');
          }
        } else {
          var place = await geocode(city);
          if (!place) throw new Error('没查到「' + city + '」，换个写法或直接填经纬度');
          latitude = place.lat;
          longitude = place.lon;
          if (pill && place.label) pill.textContent = place.label;
        }

        var url =
          'https://api.open-meteo.com/v1/forecast?latitude=' +
          latitude +
          '&longitude=' +
          longitude +
          '&current=temperature_2m,weather_code,apparent_temperature,relative_humidity_2m,wind_speed_10m,is_day' +
          '&daily=temperature_2m_max,temperature_2m_min,sunrise,sunset' +
          '&timezone=auto&forecast_days=1';
        var wx = await (await fetch(url)).json();

        var cur = wx && wx.current;
        if (!cur) throw new Error('天气数据为空');

        var code = cur.weather_code;
        var isDay = cur.is_day !== 0;
        var entry = WMO[code];
        var icon = entry ? (isDay ? entry[0] : entry[2] || entry[0]) : '🌡️';
        var text = entry ? entry[1] : '未知';

        var temp = Math.round(cur.temperature_2m);
        var feels = Math.round(cur.apparent_temperature);
        var hi = Math.round((wx.daily && wx.daily.temperature_2m_max && wx.daily.temperature_2m_max[0]) || 0);
        var lo = Math.round((wx.daily && wx.daily.temperature_2m_min && wx.daily.temperature_2m_min[0]) || 0);
        var humidity = Math.round(cur.relative_humidity_2m || 0);
        var wind = Math.round((cur.wind_speed_10m || 0) * 10) / 10;
        var sunrise = hhmm(wx.daily && wx.daily.sunrise && wx.daily.sunrise[0]);
        var sunset = hhmm(wx.daily && wx.daily.sunset && wx.daily.sunset[0]);

        body.innerHTML =
          '<div class="uw-main">' +
          '<div class="uw-icon">' + icon + '</div>' +
          '<div class="uw-main-text">' +
          '<div class="uw-temp">' + temp + '<span class="uw-deg">°</span></div>' +
          '<div class="uw-desc">' + text + ' · 体感 ' + feels + '°</div>' +
          '<div class="uw-range">今日 ' + lo + '° ~ ' + hi + '°</div>' +
          '</div></div>' +
          '<div class="uw-details">' +
          '<div class="uw-detail"><span class="uw-detail-label">湿度</span><span class="uw-detail-value">' + humidity + '%</span></div>' +
          '<div class="uw-detail"><span class="uw-detail-label">风速</span><span class="uw-detail-value">' + wind + ' km/h</span></div>' +
          '<div class="uw-detail"><span class="uw-detail-label">日出</span><span class="uw-detail-value">' + sunrise + '</span></div>' +
          '<div class="uw-detail"><span class="uw-detail-label">日落</span><span class="uw-detail-value">' + sunset + '</span></div>' +
          '</div>';
      } catch (e) {
        var msg = e && e.message ? e.message : '未知错误';
        body.innerHTML =
          '<div class="uw-error">天气获取失败：' + msg +
          '<br />（页面直接请求公开接口，失败也不影响其他内容）</div>';
      }
    }

    /* ---------- 初始化：每一次进入首页都会重跑 ----------
       旧的 interval 必须先清掉，不然每跳一页就多一个在后台空转。 */
    tick();
    if (window.__weatherTimer) clearInterval(window.__weatherTimer);
    window.__weatherTimer = setInterval(tick, 1000);

    var card = document.getElementById('weather-card');
    if (card) {
      var lat = (card.dataset.lat || '').trim();
      var lon = (card.dataset.lon || '').trim();
      var city = (card.dataset.city || '').trim();
      if ((lat && lon) || city) loadWeather(lat, lon, city);
    }
  })();
</script>
