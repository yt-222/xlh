---
import '../styles/global.css';
import '../styles/components.css';
/* 本次视觉增强层（嵌套玻璃卡片 / shimmer / 滚动提示 / 页头收缩 / 预加载屏 / 自适应网格）
   —— 想整体回退只要删掉这一行 */
import '../styles/enhance.css';
/* ClientRouter = Astro 官方版的 pjax：
   - 站内跳转变成「取 HTML + 换 DOM」，不再整页刷新（无白屏闪烁）
   - 配合 transition:persist，被标记的元素在跳转时 DOM 原样保留 ——
     音乐播放器的 <audio> 因此不会被销毁，音乐可以跨页面连续播放
   - 代价：所有一次性初始化脚本必须改成「可重复执行」或「幂等」，见下方脚本 */
import { ClientRouter } from 'astro:transitions';
import LeafFall from '@components/LeafFall.astro';
import MusicPlayer from '@components/MusicPlayer.astro';
import SearchModal from '@components/SearchModal.astro';
import ClickEffect from '@components/ClickEffect.astro';
import Live2DWidget from '@components/Live2DWidget.astro';
import { SITE } from '@/config';
import { withBase } from '@/utils/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
const pageDesc = description || SITE.description;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- 主题色（移动端浏览器地址栏也跟着变） -->
    <meta name="theme-color" content="#f7fafd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#061223" media="(prefers-color-scheme: dark)" />

    <!-- 字体：像素标题字 + 中文正文 + 代码等宽 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- 首屏前置脚本：必须在绘制前跑完，避免刷新时闪一下主题色 -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        /* 标记「有 JS」：滚动入场动画的初始隐藏只在有 JS 时生效，
           这样脚本被禁用时内容依然完整可见，不会白屏 */
        d.classList.add('has-js');
        try {
          /* 默认日间主题（白 + 蓝是本站主调）；
             只有用户明确切到夜间时才会是 'night' */
          var saved = localStorage.getItem('gravity-theme');
          if (saved !== 'night') d.classList.add('day-theme');

          /* 预加载屏只在本次会话第一次进入时播，之后跳页不再打扰 */
          if (sessionStorage.getItem('gravity-preloaded')) {
            d.classList.add('preloader-skip');
          } else {
            sessionStorage.setItem('gravity-preloaded', '1');
          }
        } catch (e) {}
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <!-- 预加载屏：纯 CSS 自动退场（1.5s），不依赖 window.load ——
         否则站内图片一多，load 被拖晚，反而拖慢感知速度。
         注意它不在常驻层里：跳页时不该再播一次 -->
    <div class="preloader" id="preloader" aria-hidden="true">
      <div class="preloader__inner">
        <div class="preloader__buddy">
          <span class="preloader__orbit"></span>
          <span class="preloader__orbit preloader__orbit--2"></span>
          <span class="preloader__core"></span>
        </div>
        <div class="preloader__dots"><i></i><i></i><i></i></div>
        <div class="preloader__text">GRAVITY CABIN</div>
      </div>
    </div>

    <!-- ============ 跨页面常驻层 ============
         transition:persist 让这一整块在站内跳转时原样保留：
           · 音乐播放器的 <audio> 不被销毁 → 换页面音乐继续播（核心诉求）
           · 落叶 / 光斑 不重播、光标光晕不重置 → 视觉连续，没有"闪一下"
           · 搜索框、点击彩蛋的实例与监听器不重建
         注意事项：这个容器绝不能加 transform / filter / backdrop-filter，
         否则会创建层叠上下文，把里面的 position:fixed 全变成相对它定位。 -->
    <div transition:persist="site-shell">
      <!-- 背景光斑：缓慢漂移的柔和色团，给纯色底加一层空气感 -->
      <div class="glow-field" aria-hidden="true">
        <span class="glow-blob glow-blob--a"></span>
        <span class="glow-blob glow-blob--b"></span>
        <span class="glow-blob glow-blob--c"></span>
      </div>

      <!-- 跟随光标的光晕（只在鼠标设备上出现） -->
      <span class="cursor-glow" id="cursorGlow" aria-hidden="true"></span>

      <LeafFall />

      <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

      <!-- 音乐播放器（左下悬浮）/ 站内搜索 / 点击彩蛋 -->
      <MusicPlayer />
      <SearchModal />
      <ClickEffect />

      <!-- Live2D 看板娘（雪初音）。放在常驻层里的原因见组件注释：
           交上去的 canvas 在跳页时被保留，人物不会闪一下重来，也不会重下贴图 -->
      <Live2DWidget />

      <button class="back-to-top" id="backToTop" aria-label="返回顶部" title="返回顶部">
        <!-- 进度环：外圈随阅读进度增长（参考 gongyeqi 的 bottom-top） -->
        <svg class="back-to-top__ring" viewBox="0 0 48 48" aria-hidden="true">
          <circle class="ring-track" cx="24" cy="24" r="23"></circle>
          <circle class="ring-value" cx="24" cy="24" r="23"></circle>
        </svg>
        <svg
          class="back-to-top__arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg>
      </button>
    </div>

    <!-- 页面内容（每次跳转都被换成新页面的内容） -->
    <slot />

    <script>
      /* =====================================================================
         在 ClientRouter 下的两条铁律（这次改造的核心约束）：
         ① 挂在 document / window 上的监听器只会挂一次 ——
            用 window.__xxx 标记守卫，否则每跳一次页就多绑一层，点击会重复触发。
         ② 跟页面内容相关的初始化（滚动入场、TOC、聚光灯…）必须放进
            astro:page-load 里重跑，因为那些 DOM 每次都被换掉了。
         ===================================================================== */

      /* ================= 主题切换（常驻，document 级代理，只需绑一次） ================= */
      const THEME_KEY = 'gravity-theme';

      if (!(window as any).__cabinThemeBound) {
        (window as any).__cabinThemeBound = true;

        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.closest('.theme-toggle-btn')) {
            const isDay = !document.documentElement.classList.contains('day-theme');
            document.documentElement.classList.toggle('day-theme', isDay);
            try {
              localStorage.setItem(THEME_KEY, isDay ? 'day' : 'night');
            } catch (err) {}
          }
        });

        /* ================= 移动端菜单（同样 document 级代理） =================
           汉堡开关只在这里处理一次 —— 导航栏组件里不再重复绑定，
           否则同一个 click 冒泡上来会被 toggle 两次，菜单看起来"点了没反应"。 */
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const toggle = target.closest('.nav-toggle');
          const links = document.querySelector('.nav-links');
          if (toggle && links) {
            const open = links.classList.toggle('open');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          } else if (links && !target.closest('.nav-links')) {
            links.classList.remove('open');
            document.querySelector('.nav-toggle')?.setAttribute('aria-expanded', 'false');
          }
        });
      }

      /* ================= 跟随光标的光晕（常驻元素，循环只起一次） ================= */
      const cursorGlow = document.getElementById('cursorGlow');
      if (cursorGlow && !cursorGlow.dataset.live) {
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          cursorGlow.dataset.live = '1';
          let targetX = window.innerWidth / 2;
          let targetY = window.innerHeight * 0.3;
          let curX = targetX;
          let curY = targetY;

          window.addEventListener(
            'pointermove',
            (e) => {
              targetX = e.clientX;
              targetY = e.clientY;
            },
            { passive: true }
          );

          /* 缓动跟随（而不是硬贴在光标上），更有滑顺的质感 */
          const follow = () => {
            curX += (targetX - curX) * 0.075;
            curY += (targetY - curY) * 0.075;
            cursorGlow.style.transform = `translate3d(${curX}px, ${curY}px, 0)`;
            requestAnimationFrame(follow);
          };
          follow();
        }
      }

      /* ================= 预加载屏收尾（只需处理一次） =================
         CSS 已负责在固定时长后自动淡出（不依赖 window.load）；
         这里只把淡出结束的图层彻底移出 DOM，免得留一个全屏层压在上面挡点击。 */
      const killPreloader = () => {
        const preloader = document.getElementById('preloader');
        if (!preloader) return;
        let killed = false;
        const kill = () => {
          if (killed) return;
          killed = true;
          preloader.remove();
        };
        preloader.addEventListener('animationend', kill, { once: true });
        /* 兜底：万一 animationend 没来（样式被覆盖、动画被禁等），3 秒后照样清掉 */
        setTimeout(kill, 3000);
      };

      /* ================= 页面级初始化：每次换页都要重跑 ================= */
      function initPage() {
        /* ---------- 阅读进度 + 返回顶部 + 页头收缩 ---------- */
        const progress = document.getElementById('readingProgress');
        const backTop = document.getElementById('backToTop');
        const navbar = document.querySelector<HTMLElement>('.navbar');

        /* 常驻层的 progress / backTop 会带着上一页的状态过来，先归零 */
        if (progress) progress.style.width = '0%';
        if (backTop) {
          backTop.classList.remove('show');
          backTop.style.setProperty('--progress', '0');
        }

        const onScroll = () => {
          const top = window.scrollY;
          const height = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = height > 0 ? Math.min(1, Math.max(0, top / height)) : 0;

          if (progress) progress.style.width = ratio * 100 + '%';

          if (backTop) {
            backTop.classList.toggle('show', top > 400);
            /* 进度环：JS 只写 0~1，具体画多少交给 CSS 的 stroke-dashoffset */
            backTop.style.setProperty('--progress', ratio.toFixed(4));
          }

          /* 页头：滚过一点点就收紧、加深背景（参考 gongyeqi 的 header-effect） */
          navbar?.classList.toggle('is-scrolled', top > 12);
        };

        /* window 上的滚动监听会跨页累积 —— 用命名函数 + 先移除再绑定 */
        const w = window as any;
        if (w.__cabinOnScroll) {
          window.removeEventListener('scroll', w.__cabinOnScroll);
          window.removeEventListener('resize', w.__cabinOnScroll);
        }
        w.__cabinOnScroll = onScroll;
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        onScroll();

        /* 返回顶部按钮在常驻层里，监听只需挂一次 */
        if (backTop && !backTop.dataset.bound) {
          backTop.dataset.bound = '1';
          backTop.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        /* ---------- 向下滚动提示 ---------- */
        const cue = document.querySelector('.scroll-cue');
        if (cue && !(cue as HTMLElement).dataset.bound) {
          (cue as HTMLElement).dataset.bound = '1';
          cue.addEventListener('click', () => {
            window.scrollBy({ top: window.innerHeight * 0.82, behavior: 'smooth' });
          });
        }

        /* ---------- 滚动入场（进入视口才播，依次错开） ----------
           比原版「页面一加载就全部播完」更耐看：往下滚时内容才一片片浮上来 */
        const revealItems = document.querySelectorAll<HTMLElement>('[data-animate]');

        /* 动画播完就摘掉动画控制（换成 .reveal-done），
           否则 animation-fill-mode 会一直压着 transform，卡片的 hover 位移会失效 */
        const finishReveal = (el: HTMLElement) => {
          el.classList.add('reveal-done');
          el.classList.remove('in-view');
        };

        if (revealItems.length) {
          revealItems.forEach((el, i) => {
            el.style.setProperty('--reveal-delay', (i % 8) * 70 + 'ms');
            el.addEventListener('animationend', () => finishReveal(el), { once: true });
          });

          if ('IntersectionObserver' in window) {
            const io = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (!entry.isIntersecting) return;
                  entry.target.classList.add('in-view');
                  io.unobserve(entry.target);
                });
              },
              { rootMargin: '0px 0px -6% 0px', threshold: 0.05 }
            );
            revealItems.forEach((el) => io.observe(el));
          } else {
            revealItems.forEach((el) => finishReveal(el));
          }
        }

        /* ---------- 数字滚动 ---------- */
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          const target = Number(el.dataset.count);
          if (!Number.isFinite(target)) return;
          const suffix = el.dataset.countSuffix || '';
          const duration = 900;
          let startTs = 0;
          const step = (ts: number) => {
            if (!startTs) startTs = ts;
            const p = Math.min(1, (ts - startTs) / duration);
            /* easeOutCubic：数字先快后慢，收尾干净 */
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(step);
          };
          el.textContent = '0' + suffix;
          requestAnimationFrame(step);
        });

        /* ---------- 聚光卡片：把鼠标位置写进 --mx / --my ----------
           CSS 用这两个变量画一个跟随鼠标的柔光，是 Aceternity / React Bits 那类
           「spotlight card」的纯 CSS 做法 */
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
          if (card.dataset.spotBound) return;
          card.dataset.spotBound = '1';
          card.addEventListener(
            'pointermove',
            (e) => {
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--mx', ((e.clientX - rect.left) / rect.width) * 100 + '%');
              card.style.setProperty('--my', ((e.clientY - rect.top) / rect.height) * 100 + '%');
            },
            { passive: true }
          );
        });
      }

      /* ================= 换页前清理残留状态 =================
         有些状态是挂在 <html> 上的，换页时不会被自动带走：
         比如灯箱开着的时候点了导航，滚动锁会一直卡住整个页面。 */
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.remove('lightbox-locked', 'search-open');
      });

      document.addEventListener('astro:page-load', initPage);
      killPreloader();
    </script>
  </body>
</html>
