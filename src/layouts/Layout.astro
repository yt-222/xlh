---
import '../styles/global.css';
import '../styles/components.css';
/* 本次视觉增强层（嵌套玻璃卡片 / shimmer / 滚动提示 / 页头收缩 / 预加载屏 / 自适应网格）
   —— 想整体回退只要删掉这一行 */
import '../styles/enhance.css';
import LeafFall from '@components/LeafFall.astro';
import { SITE } from '@/config';
import { withBase } from '@/utils/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
const pageDesc = description || SITE.description;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- 主题色（移动端浏览器地址栏也跟着变） -->
    <meta name="theme-color" content="#f7fafd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#061223" media="(prefers-color-scheme: dark)" />

    <!-- 字体：像素标题字 + 中文正文 + 代码等宽 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- 首屏前置脚本：必须在绘制前跑完，避免刷新时闪一下主题色 -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        /* 标记「有 JS」：滚动入场动画的初始隐藏只在有 JS 时生效，
           这样脚本被禁用时内容依然完整可见，不会白屏 */
        d.classList.add('has-js');
        try {
          /* 默认日间主题（白 + 蓝是本站主调）；
             只有用户明确切到夜间时才会是 'night' */
          var saved = localStorage.getItem('gravity-theme');
          if (saved !== 'night') d.classList.add('day-theme');

          /* 预加载屏只在本次会话第一次进入时播，之后跳页不再打扰 */
          if (sessionStorage.getItem('gravity-preloaded')) {
            d.classList.add('preloader-skip');
          } else {
            sessionStorage.setItem('gravity-preloaded', '1');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <!-- 预加载屏：纯 CSS 自动退场（1.5s），不依赖 window.load ——
         否则站内图片一多，load 被拖晚，反而拖慢感知速度 -->
    <div class="preloader" id="preloader" aria-hidden="true">
      <div class="preloader__inner">
        <div class="preloader__buddy">
          <span class="preloader__orbit"></span>
          <span class="preloader__orbit preloader__orbit--2"></span>
          <span class="preloader__core"></span>
        </div>
        <div class="preloader__dots"><i></i><i></i><i></i></div>
        <div class="preloader__text">GRAVITY CABIN</div>
      </div>
    </div>

    <!-- 背景光斑：缓慢漂移的柔和色团，给纯色底加一层空气感 -->
    <div class="glow-field" aria-hidden="true">
      <span class="glow-blob glow-blob--a"></span>
      <span class="glow-blob glow-blob--b"></span>
      <span class="glow-blob glow-blob--c"></span>
    </div>

    <!-- 跟随光标的光晕（只在鼠标设备上出现） -->
    <span class="cursor-glow" id="cursorGlow" aria-hidden="true"></span>

    <LeafFall />
    <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>
    <slot />

    <button class="back-to-top" id="backToTop" aria-label="返回顶部" title="返回顶部">
      <!-- 进度环：外圈随阅读进度增长（参考 gongyeqi 的 bottom-top） -->
      <svg class="back-to-top__ring" viewBox="0 0 48 48" aria-hidden="true">
        <circle class="ring-track" cx="24" cy="24" r="23"></circle>
        <circle class="ring-value" cx="24" cy="24" r="23"></circle>
      </svg>
      <svg
        class="back-to-top__arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg>
    </button>

    <script>
      /* ================= 主题切换 ================= */
      const THEME_KEY = 'gravity-theme';

      function applyTheme(isDay: boolean) {
        document.documentElement.classList.toggle('day-theme', isDay);
        try {
          localStorage.setItem(THEME_KEY, isDay ? 'day' : 'night');
        } catch (e) {}
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.theme-toggle-btn')) {
          applyTheme(!document.documentElement.classList.contains('day-theme'));
        }
      });

      /* ================= 移动端菜单 ================= */
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const toggle = target.closest('.nav-toggle');
        const links = document.querySelector('.nav-links');
        if (toggle && links) {
          links.classList.toggle('open');
        } else if (links && !target.closest('.nav-links')) {
          links.classList.remove('open');
        }
      });

      /* ================= 阅读进度 + 返回顶部 + 页头收缩 ================= */
      const progress = document.getElementById('readingProgress');
      const backTop = document.getElementById('backToTop');
      const navbar = document.querySelector<HTMLElement>('.navbar');

      function onScroll() {
        const top = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = height > 0 ? Math.min(1, Math.max(0, top / height)) : 0;

        if (progress) progress.style.width = ratio * 100 + '%';

        if (backTop) {
          backTop.classList.toggle('show', top > 400);
          /* 进度环：JS 只写 0~1，具体画多少交给 CSS 的 stroke-dashoffset */
          backTop.style.setProperty('--progress', ratio.toFixed(4));
        }

        /* 页头：滚过一点点就收紧、加深背景（参考 gongyeqi 的 header-effect） */
        navbar?.classList.toggle('is-scrolled', top > 12);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();

      backTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      /* ================= 预加载屏收尾 =================
         CSS 已负责在固定时长后自动淡出（不依赖 window.load）；
         这里只把淡出结束的图层彻底移出 DOM，免得留一个全屏层压在上面挡点击。 */
      const preloader = document.getElementById('preloader');
      if (preloader) {
        let killed = false;
        const kill = () => {
          if (killed) return;
          killed = true;
          preloader.remove();
        };
        preloader.addEventListener('animationend', kill, { once: true });
        /* 兜底：万一 animationend 没来（样式被覆盖、动画被禁等），3 秒后照样清掉 */
        setTimeout(kill, 3000);
      }

      /* ================= 向下滚动提示 ================= */
      document.querySelector('.scroll-cue')?.addEventListener('click', () => {
        window.scrollBy({ top: window.innerHeight * 0.82, behavior: 'smooth' });
      });

      /* ================= 滚动入场（进入视口才播，依次错开） =================
         比原来「页面一加载就全部播完」更耐看：往下滚时内容才一片片浮上来 */
      const revealItems = document.querySelectorAll<HTMLElement>('[data-animate]');

      /* 动画播完就摘掉动画控制（换成 .reveal-done），
         否则 animation-fill-mode 会一直压着 transform，卡片的 hover 位移会失效 */
      const finishReveal = (el: HTMLElement) => {
        el.classList.add('reveal-done');
        el.classList.remove('in-view');
      };

      if (revealItems.length) {
        revealItems.forEach((el, i) => {
          el.style.setProperty('--reveal-delay', (i % 8) * 70 + 'ms');
          el.addEventListener('animationend', () => finishReveal(el), { once: true });
        });

        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              });
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.05 }
          );
          revealItems.forEach((el) => io.observe(el));
        } else {
          revealItems.forEach((el) => finishReveal(el));
        }
      }

      /* ================= 数字滚动 ================= */
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      counters.forEach((el) => {
        const target = Number(el.dataset.count);
        if (!Number.isFinite(target)) return;
        const suffix = el.dataset.countSuffix || '';
        const duration = 900;
        let startTs = 0;
        const step = (ts: number) => {
          if (!startTs) startTs = ts;
          const p = Math.min(1, (ts - startTs) / duration);
          /* easeOutCubic：数字先快后慢，收尾干净 */
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(step);
        };
        el.textContent = '0' + suffix;
        requestAnimationFrame(step);
      });

      /* ================= 聚光卡片：把鼠标位置写进 --mx / --my =================
         CSS 用这两个变量画一个跟随鼠标的柔光，是 Aceternity / React Bits 那类
         「spotlight card」的纯 CSS 做法 */
      const spotCards = document.querySelectorAll<HTMLElement>('[data-spotlight]');
      spotCards.forEach((card) => {
        card.addEventListener(
          'pointermove',
          (e) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--mx', ((e.clientX - rect.left) / rect.width) * 100 + '%');
            card.style.setProperty('--my', ((e.clientY - rect.top) / rect.height) * 100 + '%');
          },
          { passive: true }
        );
      });

      /* ================= 跟随光标的光晕 ================= */
      const cursorGlow = document.getElementById('cursorGlow');
      if (cursorGlow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let targetX = window.innerWidth / 2;
        let targetY = window.innerHeight * 0.3;
        let curX = targetX;
        let curY = targetY;

        window.addEventListener(
          'pointermove',
          (e) => {
            targetX = e.clientX;
            targetY = e.clientY;
          },
          { passive: true }
        );

        /* 缓动跟随（而不是硬贴在光标上），更有滑顺的质感 */
        const follow = () => {
          curX += (targetX - curX) * 0.075;
          curY += (targetY - curY) * 0.075;
          cursorGlow.style.transform = `translate3d(${curX}px, ${curY}px, 0)`;
          requestAnimationFrame(follow);
        };
        follow();
      }
    </script>
  </body>
</html>
