---
import '../styles/global.css';
import SakuraEffect from '@components/SakuraEffect.astro';
import { SITE } from '@/config';
import { withBase } from '@/utils/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
const pageDesc = description || SITE.description;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- 字体：像素标题字 + 中文正文 + 代码等宽 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- 主题预加载：在首次绘制前就把 day-theme 挂上，避免刷新时闪一下 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('xlh-theme');
          var isDay = saved === 'day';
          if (isDay) document.documentElement.classList.add('day-theme');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <SakuraEffect />
    <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>
    <slot />

    <button class="back-to-top" id="backToTop" aria-label="返回顶部" title="返回顶部">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg>
    </button>

    <script>
      /* ---------- 主题切换 ---------- */
      const THEME_KEY = 'xlh-theme';

      function applyTheme(isDay: boolean) {
        document.documentElement.classList.toggle('day-theme', isDay);
        try {
          localStorage.setItem(THEME_KEY, isDay ? 'day' : 'night');
        } catch (e) {}
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.theme-toggle-btn')) {
          applyTheme(!document.documentElement.classList.contains('day-theme'));
        }
      });

      /* ---------- 移动端菜单 ---------- */
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const toggle = target.closest('.nav-toggle');
        const links = document.querySelector('.nav-links');
        if (toggle && links) {
          links.classList.toggle('open');
        } else if (links && !target.closest('.nav-links')) {
          links.classList.remove('open');
        }
      });

      /* ---------- 阅读进度 + 返回顶部 ---------- */
      const progress = document.getElementById('readingProgress');
      const backTop = document.getElementById('backToTop');

      function onScroll() {
        const top = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        if (progress) progress.style.width = height > 0 ? (top / height) * 100 + '%' : '0%';
        if (backTop) backTop.classList.toggle('show', top > 400);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();

      backTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      /* ---------- 卡片入场动画（依次淡入） ---------- */
      const cards = document.querySelectorAll<HTMLElement>('[data-animate]');
      cards.forEach((card, i) => {
        card.style.animationDelay = Math.min(i, 10) * 60 + 'ms';
        card.classList.add('animate-in');
      });
    </script>
  </body>
</html>
