# =============================================================================
# Cloudflare Pages 响应头配置
# 放在 public/ 下，构建时会原样复制到 dist/_headers，由 Pages 在边缘生效。
# 文档：https://developers.cloudflare.com/pages/configuration/headers/
# =============================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# -----------------------------------------------------------------------------
# 静态资源：文件名里带内容哈希（Astro 构建产物 /_astro/xxx.HASH.css），
# 内容一变文件名就变，所以可以放心设一年不可变缓存 —— 这是首屏提速最大的一项。
# -----------------------------------------------------------------------------
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# -----------------------------------------------------------------------------
# 图片：由 build-images.mjs 产出，文件名形如 <slug>-<hash8>-1600.webp，
# 同样带内容哈希，可以永久缓存。换图后哈希变、URL 变，浏览器自动取新的，
# 不需要手动清 Cloudflare 缓存。
# -----------------------------------------------------------------------------
/media/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# -----------------------------------------------------------------------------
# HTML：绝不能长缓存，否则用户会一直看到旧页面。
# max-age=0 + must-revalidate 让浏览器每次都回边缘校验（边缘命中时很快）。
# -----------------------------------------------------------------------------
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# -----------------------------------------------------------------------------
# 站点地图与 RSS：中等缓存
# -----------------------------------------------------------------------------
/sitemap.xml
  Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=3600
